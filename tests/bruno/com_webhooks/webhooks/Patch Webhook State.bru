meta {
  name: Patch Webhook State
  type: http
  seq: 5
}

patch {
  url: {{baseUrl}}/index.php/v1/webhooks/{{webhookId}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{token}}
}

body:json {
  {
    "state": 0
  }
}

assert {
  res.status: eq 200
  res.body.data.attributes.state: eq 0
}
