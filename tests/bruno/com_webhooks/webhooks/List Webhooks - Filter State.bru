meta {
  name: List Webhooks - Filter State
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/index.php/v1/webhooks?filter[state]=1
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{token}}
}

assert {
  res.status: eq 200
  res.headers['content-type']: contains application/vnd.api+json
  res.body.data: isDefined
}
