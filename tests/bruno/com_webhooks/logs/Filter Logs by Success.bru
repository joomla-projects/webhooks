meta {
  name: Filter Logs by Success
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/index.php/v1/webhooks/logs?filter[success]=1
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{token}}
}

assert {
  res.status: eq 200
  res.headers['content-type']: contains application/vnd.api+json
  res.body.data: isDefined
}
