meta {
  name: Filter Logs by Event
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/index.php/v1/webhooks/logs?filter[event_name]=content.new
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{token}}
}

assert {
  res.status: eq 200
  res.headers['content-type']: contains application/vnd.api+json
  res.body.data: isDefined
}
