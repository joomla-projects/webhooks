meta {
  name: Filter Logs by Date
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/index.php/v1/webhooks/logs?filter[created_from]=2024-01-01&filter[created_to]=2030-12-31
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{token}}
}

assert {
  res.status: eq 200
  res.headers['content-type']: contains application/vnd.api+json
  res.body.data: isDefined
}
