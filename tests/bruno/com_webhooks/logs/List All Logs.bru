meta {
  name: List All Logs
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/index.php/v1/webhooks/logs
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{token}}
}

assert {
  res.status: eq 200
  res.headers['content-type']: contains application/vnd.api+json
  res.body.data: isDefined
}
