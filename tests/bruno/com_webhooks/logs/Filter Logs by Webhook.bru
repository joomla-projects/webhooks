meta {
  name: Filter Logs by Webhook
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/index.php/v1/webhooks/logs?filter[webhook_id]={{webhookId}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{token}}
}

assert {
  res.status: eq 200
  res.headers['content-type']: contains application/vnd.api+json
  res.body.data: isDefined
}
